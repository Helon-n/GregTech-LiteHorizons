{
  "name": "gregtech-litehorizons",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "description": "GTNH-inspired offline idle factory game for Windows",
  "author": "GregTech-LiteHorizons Project",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:ui:tiers": "node scripts/ui-tiers.mjs",
    "test:ui:energy": "node scripts/ui-energy.mjs",
    "test:ui:layout": "node scripts/ui-window-layout.mjs",
    "test:ui:performance": "node scripts/ui-performance.mjs",
    "test:desktop": "node scripts/electron-smoke.mjs",
    "test:desktop:construction": "node scripts/ui-construction.mjs",
    "dev:web": "node scripts/serve.mjs",
    "dist": "electron-builder --win nsis portable --x64",
    "pack": "electron-builder --win --dir --x64",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "import:instance": "python scripts/import-instance.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.gtnh.idle",
    "productName": "GregTech-LiteHorizons",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "src/assets/app-icon.ico",
      "artifactName": "GregTech-LiteHorizons-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "GregTech-LiteHorizons-${version}-Portable.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
